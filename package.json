{
  "name": "dsh-coding-sound",
  "version": "0.2.0",
  "type": "module",
  "description": "Generative background music and notification chimes for DeepSeek Harness: hear whether the agent is thinking, still working, or waiting for you, without watching the screen.",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "mhlywxl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhlywxl/dsh-coding-sound.git"
  },
  "homepage": "https://github.com/mhlywxl/dsh-coding-sound#readme",
  "bugs": {
    "url": "https://github.com/mhlywxl/dsh-coding-sound/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "audio",
    "sound",
    "music",
    "background-music",
    "notification",
    "notification-sound",
    "chime",
    "alert",
    "attention",
    "focus",
    "productivity",
    "web-audio",
    "generative-music"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs --watch",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "node scripts/build-client.mjs --check && node test.mjs",
    "check": "node scripts/build-client.mjs --check && node --check client.js && node test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
